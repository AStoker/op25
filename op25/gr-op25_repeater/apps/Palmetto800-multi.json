        "control_channel_list": "859.26250,853.50000,855.46250,860.88750",
        "tgid_tags_file": "palmetto_tgs.tsv",
        "nac": "0x1D1",
        "#site": "RFSS 2 / Site 32 (0x20); primary CC 859.2625, secondaries per sccb",
        "#sysid": "0x1D9",
        "#wacn": "0xBEE00",
        "whitelist": "",
        "blacklist": "",
        "crypt_behavior": 2
      }
    ]
  },
  "audio": {
    "module": "sockaudio.py",
    "instances": [
