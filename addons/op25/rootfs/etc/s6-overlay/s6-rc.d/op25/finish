#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Take the s6 supervision tree down when the decoder exits.
#
# Without this s6 would restart the service in place, silently looping a
# flowgraph that cannot start (missing dongle, bad frequency, USB claimed by
# something else). Halting instead surfaces the exit to Supervisor, so the
# add-on shows as stopped and its own restart/watchdog policy applies.
# ==============================================================================
# shellcheck disable=SC2155
readonly exit_code_container=$(</run/s6-linux-init-container-results/exitcode)
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"

bashio::log.info "OP25 exited (service ${exit_code_service}, signal ${exit_code_signal})"

if [[ "${exit_code_service}" -eq 256 ]]; then
    # Killed by a signal. SIGTERM (15) during a normal stop is not an error.
    if [[ "${exit_code_container}" -eq 0 ]]; then
        echo $((128 + exit_code_signal)) > /run/s6-linux-init-container-results/exitcode
    fi
    [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${exit_code_service}" -ne 0 ]]; then
    if [[ "${exit_code_container}" -eq 0 ]]; then
        echo "${exit_code_service}" > /run/s6-linux-init-container-results/exitcode
    fi
    exec /run/s6/basedir/bin/halt
fi
