#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Pre-flight: validate the config and show what hardware we can see.
#
# Runs once, before the decoder. Everything here is about making the common
# first-run failures say what is wrong instead of producing a Python traceback
# or a silent receiver.
# ==============================================================================
declare config_file work_dir

config_file=$(bashio::config 'config_file')
work_dir=$(bashio::config 'work_dir')

mkdir -p "$(dirname "${config_file}")" 2>/dev/null || true

# Seed a working config on first run rather than refusing to start.
#
# Getting a file into an add-on's config directory on Home Assistant OS is the
# single most awkward step of installing this: there is no host shell, and the
# addon_configs share only appears if the Samba add-on is recent enough and the
# user knows to look for it.  So write the sample out ourselves.  The user can
# then edit it in place through whatever file access they do have -- and if
# they have none yet, the add-on still starts and the UI still comes up.
if ! bashio::fs.file_exists "${config_file}"; then
    if cp /opt/op25/samples/op25.sample.json "${config_file}" 2>/dev/null; then
        bashio::log.warning "No config found, so a sample was written to:"
        bashio::log.warning "    ${config_file}"
        bashio::log.warning ""
        bashio::log.warning "It is set up for the Palmetto 800 P25 system in South"
        bashio::log.warning "Carolina.  If that is not your system, edit the"
        bashio::log.warning "control_channel_list and frequencies -- otherwise the"
        bashio::log.warning "receiver will run but never lock."
        bashio::log.warning ""
        bashio::log.warning "Talkgroup names need a .tsv alongside it (see"
        bashio::log.warning "trunking.chans[].tgid_tags_file).  Without one you get"
        bashio::log.warning "talkgroup numbers, which is harmless."
    else
        bashio::log.fatal "No config at ${config_file}, and the sample could not"
        bashio::log.fatal "be written there -- is the directory writable?"
        bashio::log.fatal "See https://github.com/AStoker/op25/blob/main/addons/op25/DOCS.md"
        bashio::exit.nok
    fi
fi

if ! jq empty "${config_file}" 2>/dev/null; then
    bashio::log.fatal "${config_file} is not valid JSON."
    jq empty "${config_file}" 2>&1 | while read -r line; do
        bashio::log.fatal "  ${line}"
    done
    bashio::exit.nok
fi

# cwd is load-bearing: tgid_tags_file, rid_tags_file, whitelist/blacklist and
# crypt_keys are all opened with a bare open() relative to it.
mkdir -p "${work_dir}" /data/plots

bashio::log.info "Config:   ${config_file}"
bashio::log.info "Work dir: ${work_dir}"

# ------------------------------------------------------------------ hardware -
if [ -d /dev/bus/usb ]; then
    bashio::log.info "USB bus is visible to the container."
else
    bashio::log.warning "No /dev/bus/usb -- is 'usb: true' being honoured?"
    bashio::log.warning "Without it no SDR can be opened."
fi

bashio::log.info "Enumerating RTL-SDR devices. The serial numbers below are"
bashio::log.info "what a device's \"args\": \"rtl=<serial>\" must match:"
# rtl_test -t always ends with "No E4000 tuner found, aborting." -- that is an
# E4000-only benchmark declining to run, not a failure.
if ! rtl_test -t 2>&1 | head -n 20 | while read -r line; do
        bashio::log.info "  ${line}"
    done; then
    bashio::log.warning "rtl_test failed; continuing anyway (the config may"
    bashio::log.warning "use a non-RTL device, or a file/IQ source)."
fi
