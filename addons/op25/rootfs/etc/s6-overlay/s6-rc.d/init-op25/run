#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Pre-flight: validate the config and show what hardware we can see.
#
# Runs once, before the decoder. Everything here is about making the common
# first-run failures say what is wrong instead of producing a Python traceback
# or a silent receiver.
# ==============================================================================
declare config_file work_dir preset base_config

config_file=$(bashio::config 'config_file')
work_dir=$(bashio::config 'work_dir')
preset=$(bashio::config 'preset')

# ------------------------------------------------------------------- config --
# With a preset selected the config comes from inside the image, so there is
# nothing to seed and nothing on disk that can go stale -- which is the point:
# a seeded file is written once and then never touched again (overwriting the
# user's edits would be worse), so it cannot receive a fix. Only `custom` uses a
# file, and only then is a first-run copy worth making: getting a file into an
# add-on's config directory on Home Assistant OS is the single most awkward step
# of installing this. There is no host shell, and the addon_configs share only
# appears if the Samba add-on is recent enough and the user knows to look.
if [ "${preset}" = "custom" ]; then
    mkdir -p "$(dirname "${config_file}")" 2>/dev/null || true

    if ! bashio::fs.file_exists "${config_file}"; then
        if cp /opt/op25/presets/palmetto800.json "${config_file}" 2>/dev/null; then
            bashio::log.warning "preset is 'custom' but ${config_file} did not exist,"
            bashio::log.warning "so the palmetto800 preset was copied there as a"
            bashio::log.warning "starting point. Edit it for your system --"
            bashio::log.warning "control_channel_list and nac at minimum, or the"
            bashio::log.warning "receiver will run but never lock."
            bashio::log.warning ""
            bashio::log.warning "This copy will NOT track add-on updates. If you do"
            bashio::log.warning "monitor Palmetto 800, delete it and set preset back"
            bashio::log.warning "to 'palmetto800'."
        else
            bashio::log.fatal "preset is 'custom' but there is no config at"
            bashio::log.fatal "${config_file}, and a starting point could not be"
            bashio::log.fatal "written there -- is the directory writable?"
            bashio::log.fatal "See https://github.com/AStoker/op25/blob/main/addons/op25/DOCS.md"
            bashio::exit.nok
        fi
    fi
    base_config="${config_file}"
else
    base_config="/opt/op25/presets/${preset}.json"
    if [ ! -f "${base_config}" ]; then
        bashio::log.fatal "No built-in preset named '${preset}'. Available:"
        for p in /opt/op25/presets/*.json; do
            bashio::log.fatal "    $(basename "${p}" .json)"
        done
        bashio::exit.nok
    fi
fi

if ! jq empty "${base_config}" 2>/dev/null; then
    bashio::log.fatal "${base_config} is not valid JSON."
    jq empty "${base_config}" 2>&1 | while read -r line; do
        bashio::log.fatal "  ${line}"
    done
    bashio::exit.nok
fi

# cwd is load-bearing: tgid_tags_file, rid_tags_file, whitelist/blacklist and
# crypt_keys are all opened with a bare open() relative to it -- and so is
# op25_metadata.sqlite, the talkgroup last-heard cache tg_metadata.py writes.
# That one lands here rather than under /data so it survives an add-on
# reinstall, same as the user's config; it is a cache and safe to delete.
mkdir -p "${work_dir}" /data/plots

if [ "${preset}" = "custom" ]; then
    bashio::log.info "Config:   ${config_file} (preset: custom)"
else
    bashio::log.info "Config:   built-in preset '${preset}'"
fi
bashio::log.info "Work dir: ${work_dir}"

# ------------------------------------------------------------------ hardware -
if [ -d /dev/bus/usb ]; then
    bashio::log.info "USB bus is visible to the container."
else
    bashio::log.warning "No /dev/bus/usb -- is 'usb: true' being honoured?"
    bashio::log.warning "Without it no SDR can be opened."
fi

bashio::log.info "Enumerating RTL-SDR devices. The serial numbers below are"
bashio::log.info "what a device's \"args\": \"rtl=<serial>\" must match:"
# rtl_test -t always ends with "No E4000 tuner found, aborting." -- that is an
# E4000-only benchmark declining to run, not a failure.
if ! rtl_test -t 2>&1 | head -n 20 | while read -r line; do
        bashio::log.info "  ${line}"
    done; then
    bashio::log.warning "rtl_test failed; continuing anyway (the config may"
    bashio::log.warning "use a non-RTL device, or a file/IQ source)."
fi
