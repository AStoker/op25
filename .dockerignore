# The add-on image is built with the repository root as its context, so keep
# the ~560 MB of local build state out of it. Without this a build from a
# working tree copies node_modules (463 MB), apps/.venv (59 MB), build/ (39 MB)
# and the user's real (gitignored) configs into the daemon.

.git
.github
.vscode
.DS_Store

# Build state
build/
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache

# Local runtime artifacts (see apps/.gitignore)
op25/gr-op25_repeater/apps/op25_python
op25/gr-op25_repeater/apps/stderr*
op25/gr-op25_repeater/apps/*.2

# Not needed to build or run
# The top-level docs/ is doxygen output and unused (add_subdirectory(docs) is
# commented out).  op25/*/docs is NOT excluded: pydoc_macros.h and
# update_pydoc.py in there are pybind build inputs.
docs
field-test
*.md
# Store assets: Supervisor reads these from the repo, not from the image.
addons/*/icon.png
addons/*/logo.png
